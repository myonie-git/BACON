+
+/*
+ * A minimal demo showing how to use the parallel RRT planner (pRRT)
+ * for joint-space planning in an N-DoF configuration space.
+ *
+ * Build target name: demo_pRRTJointSpacePlanning
+ * Typical build output path: <build>/demos/demo_pRRTJointSpacePlanning
+ */
+
+#include <ompl/base/spaces/RealVectorStateSpace.h>
+#include <ompl/config.h>
+#include <ompl/geometric/SimpleSetup.h>
+#include <ompl/geometric/planners/rrt/pRRT.h>
+#include <ompl/util/RandomNumbers.h>
+
+#include <boost/program_options.hpp>
+
+#include <algorithm>
+#include <cstdint>
+#include <cstddef>
+#include <iostream>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace ob = ompl::base;
+namespace og = ompl::geometric;
+namespace po = boost::program_options;
+
+static unsigned int defaultThreadCount()
+{
+    unsigned int hw = std::thread::hardware_concurrency();
+    if (hw == 0)
+        hw = 1;
+    return std::min(4u, hw);
+}
+
+static void printVector(std::ostream &out, const std::vector<double> &v)
+{
+    out << "[";
+    for (std::size_t i = 0; i < v.size(); ++i)
+    {
+        out << v[i];
+        if (i + 1 < v.size())
+            out << ", ";
+    }
+    out << "]";
+}
+
+int main(int argc, char **argv)
+{
+    unsigned int threads = defaultThreadCount();
+    double time = 1.0;
+    double range = 0.0;  // 0 => let OMPL auto-configure
+    double goalBias = 0.05;
+    bool simplify = true;
+
+    unsigned int dof = 7;
+    // Teaching/demo bounds for sampling. These are not "true joint limits" unless you choose so.
+    double jointLow = -3.14159265358979323846;
+    double jointHigh = 3.14159265358979323846;
+    double goalTolerance = 1e-3;
+
+    std::vector<double> startVec;
+    std::vector<double> goalVec;
+
+    po::options_description desc("demo_pRRTJointSpacePlanning options");
+    desc.add_options()
+        ("help,h", "Show this help message")
+        ("threads,j", po::value<unsigned int>(&threads)->default_value(threads),
+         "Number of threads for pRRT (>=1). Note: pRRT advertises a 1..64 range.")
+        ("time,t", po::value<double>(&time)->default_value(time), "Planning time in seconds")
+        ("range,r", po::value<double>(&range)->default_value(range),
+         "Maximum extension length in joint space (0 => auto-configure)")
+        ("goal-bias", po::value<double>(&goalBias)->default_value(goalBias),
+         "Probability of sampling the goal (0..1)")
+        ("dof,n", po::value<unsigned int>(&dof)->default_value(dof),
+         "Number of joints / DoF (>=1)")
+        ("joint-low", po::value<double>(&jointLow)->default_value(jointLow),
+         "Lower bound used for sampling ALL joints (teaching/demo bound)")
+        ("joint-high", po::value<double>(&jointHigh)->default_value(jointHigh),
+         "Upper bound used for sampling ALL joints (teaching/demo bound)")
+        ("goal-tol", po::value<double>(&goalTolerance)->default_value(goalTolerance),
+         "Goal tolerance (radius) in joint space")
+        ("start", po::value<std::vector<double>>(&startVec)->multitoken(),
+         "Start joint angles, provide N numbers: --start q0 q1 ... q{N-1}")
+        ("goal", po::value<std::vector<double>>(&goalVec)->multitoken(),
+         "Goal joint angles, provide N numbers: --goal q0 q1 ... q{N-1}")
+        ("no-simplify", po::bool_switch()->default_value(false),
+         "Disable post-processing (solution path simplification)")
+        ("seed", po::value<std::uint_fast32_t>(),
+         "Global OMPL RNG seed (for repeatability)");
+
+    po::variables_map vm;
+    try
+    {
+        po::store(po::parse_command_line(argc, argv, desc), vm);
+        po::notify(vm);
+    }
+    catch (const std::exception &e)
+    {
+        std::cerr << "Error parsing arguments: " << e.what() << "\n\n" << desc << std::endl;
+        return 2;
+    }
+
+    if (vm.count("help") != 0u)
+    {
+        std::cout << desc << std::endl;
+        return 0;
+    }
+
+    if (vm.count("seed") != 0u)
+        ompl::RNG::setSeed(vm["seed"].as<std::uint_fast32_t>());
+
+    if (threads < 1)
+        threads = 1;
+    // Keep within the advertised parameter range for safety.
+    threads = std::min(threads, 64u);
+
+    simplify = !vm["no-simplify"].as<bool>();
+
+    if (dof < 1)
+        dof = 1;
+
+    if (!(jointHigh > jointLow))
+    {
+        std::cerr << "Invalid bounds: --joint-high must be > --joint-low" << std::endl;
+        return 2;
+    }
+
+    if (!startVec.empty() && startVec.size() != dof)
+    {
+        std::cerr << "Invalid --start: expected " << dof << " values, got " << startVec.size() << std::endl;
+        return 2;
+    }
+    if (!goalVec.empty() && goalVec.size() != dof)
+    {
+        std::cerr << "Invalid --goal: expected " << dof << " values, got " << goalVec.size() << std::endl;
+        return 2;
+    }
+
+    if (startVec.empty())
+        startVec.assign(dof, 0.0);
+    if (goalVec.empty())
+        goalVec.assign(dof, 0.5);
+
+    std::cout << "OMPL version: " << OMPL_VERSION << std::endl;
+    std::cout << "Planner: pRRT (threads=" << threads << ", time=" << time << "s"
+              << ", range=" << range << ", goal_bias=" << goalBias << ")\n";
+    std::cout << "Joint-space: RealVectorStateSpace(dof=" << dof << "), bounds=[" << jointLow << ", " << jointHigh
+              << "], goal_tol=" << goalTolerance << "\n";
+    std::cout << "Start: ";
+    printVector(std::cout, startVec);
+    std::cout << "\nGoal : ";
+    printVector(std::cout, goalVec);
+    std::cout << "\n";
+
+    // Configuration space: R^N with simple uniform bounds for all joints.
+    auto space = std::make_shared<ob::RealVectorStateSpace>(dof);
+    ob::RealVectorBounds bounds(dof);
+    for (unsigned int i = 0; i < dof; ++i)
+    {
+        bounds.setLow(i, jointLow);
+        bounds.setHigh(i, jointHigh);
+    }
+    space->setBounds(bounds);
+
+    og::SimpleSetup ss(space);
+    // No obstacles/collision checking for this teaching demo: only enforce sampling bounds.
+    ss.setStateValidityChecker([space](const ob::State *state) { return space->satisfiesBounds(state); });
+
+    ob::ScopedState<ob::RealVectorStateSpace> start(space);
+    ob::ScopedState<ob::RealVectorStateSpace> goal(space);
+    for (unsigned int i = 0; i < dof; ++i)
+    {
+        start[i] = startVec[i];
+        goal[i] = goalVec[i];
+    }
+    ss.setStartAndGoalStates(start, goal, goalTolerance);
+
+    auto planner = std::make_shared<og::pRRT>(ss.getSpaceInformation());
+    planner->setThreadCount(threads);
+    planner->setGoalBias(goalBias);
+    if (range > 0.0)
+        planner->setRange(range);
+    ss.setPlanner(planner);
+
+    ss.setup();
+    ss.print();
+
+    const ob::PlannerStatus solved = ss.solve(time);
+    if (solved)
+    {
+        std::cout << "Found solution" << (solved.asString() == std::string("Exact solution") ? "" : " (approx)")
+                  << ":\n";
+        if (simplify)
+            ss.simplifySolution();
+        ss.getSolutionPath().printAsMatrix(std::cout);
+        return 0;
+    }
+
+    std::cout << "No solution found" << std::endl;
+    return 1;
+}
+
+
